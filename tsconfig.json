{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "declaration": true, "outDir": "js", "rootDir": "src", "removeComments": false
  },
  "include": ["src"]
}
